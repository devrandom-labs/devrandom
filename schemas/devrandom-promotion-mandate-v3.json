      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9_-]{43}$"
    },
    "i": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9_-]{43}$"
    },
    "ri": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9_-]{43}$"
    },
    "s": {
