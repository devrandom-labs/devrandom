{
  "name": "@devrandom/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "devrandom-server": "dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "credential-schema": "tsx src/credential-schema-artifact.ts && prettier --write --log-level silent ../../schemas/devrandom-credential.json ../../schemas/devrandom-task-mandate.json ../../schemas/devrandom-task-mandate-v2.json ../../schemas/devrandom-promotion-mandate.json ../../schemas/devrandom-promotion-mandate-v2.json ../../schemas/devrandom-promotion-mandate-v3.json",
    "dev": "tsx src/main.ts",
    "openapi": "tsx src/openapi.ts && prettier --write --log-level silent openapi.json",
    "smoke": "tsx src/smoke.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@devrandom/domain": "workspace:*",
    "@devrandom/identity": "workspace:*",
    "@devrandom/protocol": "workspace:*",
    "@fastify/swagger": "9.9.0",
    "@fastify/type-provider-typebox": "catalog:",
    "fastify": "5.12.5",
    "mongodb": "catalog:",
    "typebox": "catalog:"
  }
}
