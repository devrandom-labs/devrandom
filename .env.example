# Private service-only demonstration configuration. Copy this file to the
# gitignored `.env`, set the issuer bran, and run `chmod 600 .env`. `just up`
# and Docker Compose read it; the `devrandom` CLI does not.
DEVRANDOM_COMPOSE_PROJECT=devrandom
# Required private issuer bootstrap secret. Do not commit or share it.
# DEVRANDOM_ISSUER_BRAN=
DEVRANDOM_ISSUER_PORT=3211
DEVRANDOM_SITE_PORT=3210
DEVRANDOM_KERIA_ADMIN_PORT=3901
DEVRANDOM_KERIA_HTTP_PORT=3902
DEVRANDOM_KERIA_BOOT_PORT=3903
DEVRANDOM_MONGODB_PORT=27017
DEVRANDOM_WITNESS_WAN_PORT=5642
DEVRANDOM_WITNESS_WIL_PORT=5643
DEVRANDOM_WITNESS_WES_PORT=5644
